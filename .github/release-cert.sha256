# SHA-256 fingerprint of the Vach release signing certificate.
# The release workflow fails unless the APK's signer matches this value.
# It is public (the README shows the same value), not a secret.
#
# Replace UNSET below with the "SHA256:" line printed by:
#   keytool -list -v -keystore vach-release.jks -alias vach
# The "SHA256:" prefix, colons, spaces and letter case don't matter.
SHA256: 76:4D:06:30:1A:99:9B:76:49:CF:C6:D6:B6:DC:D1:56:87:C1:16:25:89:55:9B:A5:C3:7B:8C:9C:35:F8:27:FF
